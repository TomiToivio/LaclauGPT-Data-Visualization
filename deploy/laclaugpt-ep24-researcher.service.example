# EP24 FI/PL/PT researcher dashboard, Laskin :8502 (issue #242).
#
# A systemd *user* unit, matching the other Laskin deployments (ep24-fiplpt, laclaugpt-live-steps,
# laclaugpt-visualization-ai26). Copy to ~/.config/systemd/user/ and change the three marked lines.
# The artifact directory is private data and must live outside the repository.
[Unit]
Description=LaclauGPT EP24 FI/PL/PT researcher dashboard (Laskin :8502, issue #242)
Documentation=file:///mnt/workspace/LaclauGPT-Data-Visualization/docs/EP24_RESEARCHER_LASKIN.md
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# --- change 1: the checkout this service runs ---
WorkingDirectory=/mnt/workspace/LaclauGPT-Data-Visualization
# --- change 2: the private artifact root built by tools/build_live_steps_artifacts.py ---
Environment=LACLAUGPT_VIS_LIVE_STEPS_DATA=/mnt/workspace/LP-live/analysis/live_steps_1_7
Environment=LACLAUGPT_VIS_PYTHON=/mnt/workspace/LaclauGPT-Data-Visualization/.venv/bin/python
# Optional second gate; set it in an EnvironmentFile with mode 0600, never here:
# EnvironmentFile=-%h/.config/laclaugpt-ep24-researcher.env
Environment=PYTHONUNBUFFERED=1
# --- change 3: bind address. Tailscale address for tailnet-only access; never 0.0.0.0 ---
ExecStart=/mnt/workspace/LaclauGPT-Data-Visualization/scripts/ep24/serve_researcher_dashboard.sh 8502 100.115.95.109
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/mnt/workspace/LaclauGPT-Private/analysis/ep24/logs/researcher_8502.log
StandardError=append:/mnt/workspace/LaclauGPT-Private/analysis/ep24/logs/researcher_8502.log

[Install]
WantedBy=default.target
