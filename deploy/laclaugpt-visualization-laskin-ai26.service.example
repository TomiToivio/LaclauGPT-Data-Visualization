[Unit]
Description=LaclauGPT AI26 Data Visualization (Laskin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
Group=<service-group>
WorkingDirectory=<visualization-root>
Environment=LACLAUGPT_VIS_REPO_ROOT=<visualization-root>
Environment=LACLAUGPT_VIS_ENV_FILE=<private-env-file>
# The preflight requires the canonical Phase 1 browser contract, and the application
# default is deliberately Phase 0 (compatibility), so the deployment must select it here
# rather than rely on a default. Provisioned in the EnvironmentFile as well for
# non-systemd launches; keep the two in agreement.
Environment=LACLAUGPT_VIS_BROWSER_DATA_CONTRACT=canonical
EnvironmentFile=<private-env-file>
ExecStartPre=<visualization-root>/deploy/preflight-laskin-ai26.sh
ExecStart=<visualization-root>/.venv/bin/laclaugpt-visualize serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=<visualization-root>
ReadWritePaths=<private-runtime-root>
UMask=0077

[Install]
WantedBy=multi-user.target
