[Unit]
Description=AI26 consolidated researcher dashboard (Laskin :8504, issue #330)
Documentation=https://github.com/TomiToivio/LaclauGPT-Data-Visualization/issues/330
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/LaclauGPT-Data-Visualization
EnvironmentFile=%h/.config/laclaugpt/ai26/dashboard.env
Environment=LACLAUGPT_VIS_REPO_ROOT=%h/LaclauGPT-Data-Visualization
Environment=LACLAUGPT_VIS_ENV_FILE=%h/.config/laclaugpt/ai26/dashboard.env
Environment=LACLAUGPT_VIS_BROWSER_DATA_CONTRACT=canonical
Environment=LACLAUGPT_VIS_SERVER_PORT=8504
ExecStartPre=%h/LaclauGPT-Data-Visualization/deploy/preflight-laskin-ai26.sh
ExecStart=%h/LaclauGPT-Data-Visualization/.venv/bin/laclaugpt-visualize serve
# The dashboard is a research interface, not a batch job: it must never start analysis by loading.
Restart=on-failure
RestartSec=20
StandardOutput=append:%h/.config/laclaugpt/ai26/dashboard.log
StandardError=append:%h/.config/laclaugpt/ai26/dashboard.log

[Install]
WantedBy=default.target
