# Environment template for a public AI26 demo copy (#342).
#
# Copy to a private location on the demo host, replace every <placeholder>, and keep the file
# at mode 0600. Never commit it, never put it in Git, never paste its filled contents into an
# issue. The values below are names the application reads, not settings taken from Laskin.
#
# The copy must not contain: private research records, raw capture payloads, evidence quotes
# that are not approved for publication, credentials, SSH material, internal hostnames, or
# paths from the development machine.

# --- identity ------------------------------------------------------------------------------
LACLAUGPT_VIS_PROJECT_ID=ai26
LACLAUGPT_VIS_PROFILE=custom
LACLAUGPT_VIS_MACHINE=custom
LACLAUGPT_VIS_EXECUTION=web-service
LACLAUGPT_VIS_CALLER=public-demo

# --- data source ---------------------------------------------------------------------------
# The dashboard requires distributed storage with a MongoDB durable store; it performs live
# queries, so the copy reads a read-only database that holds the approved demo snapshot.
LACLAUGPT_VIS_STORAGE=distributed
LACLAUGPT_VIS_DATA_BACKEND=mongodb
LACLAUGPT_VIS_STORAGE_BACKEND=mongodb
LACLAUGPT_VIS_BROWSER_DATA_CONTRACT=canonical
LACLAUGPT_VIS_MONGODB_URI=mongodb://<read-only-user>:<password>@<demo-db-host>:27017/<database>?authSource=<auth-db>
LACLAUGPT_VIS_MONGODB_DATABASE=<demo-database>

# --- deliberately off -----------------------------------------------------------------------
# No cache plane, no object store, no messaging: a copy that cannot write cannot publish
# configuration proposals or depend on another module's infrastructure.
LACLAUGPT_VIS_CACHE_BACKEND=memory
LACLAUGPT_VIS_OBJECT_BACKEND=local
LACLAUGPT_VIS_MESSAGING_BACKEND=none

# --- serving --------------------------------------------------------------------------------
# Bind loopback and put the public HTTPS endpoint behind a reverse proxy. Do not bind a public
# interface from Streamlit itself.
LACLAUGPT_VIS_SERVER_HOST=127.0.0.1
LACLAUGPT_VIS_SERVER_PORT=8600
LACLAUGPT_VIS_DATA_DIR=<demo-runtime-root>/data
LACLAUGPT_VIS_OUTPUT_DIR=<demo-runtime-root>/data/exports

# --- demo surface ----------------------------------------------------------------------------
# demo_mode removes Records, RAG Chat, Configuration, Hermes and Diagnostics from the served
# application: raw corpus text, model access, effective configuration and agent operations.
LACLAUGPT_VIS_DEMO_MODE=true
# Shown verbatim in the banner, for example "synthetic fixture" or
# "approved snapshot 2026-11-27 (AI26, n=1200)". No personal data, no record text.
LACLAUGPT_VIS_DEMO_DATA_LABEL=<what this copy is showing>
