# Copy to .env and edit locally. Never commit .env.

# Composable deployment dimensions
LACLAUGPT_VIS_PROFILE=local
LACLAUGPT_VIS_MACHINE=laptop
LACLAUGPT_VIS_EXECUTION=cli
LACLAUGPT_VIS_STORAGE=local
LACLAUGPT_VIS_CALLER=human-cli
LACLAUGPT_VIS_PROJECT_ID=default

# Browser data contract is explicit. Keep the application compatibility default (phase0)
# unless a deployment intentionally opts into the canonical Phase 1 contract.
# LACLAUGPT_VIS_BROWSER_DATA_CONTRACT=canonical
LACLAUGPT_VIS_BROWSER_DATA_CONTRACT=phase0

# Research read/query policy. auto prefers MongoDB only when a private URI is configured,
# then falls back to CSV/local if it is unavailable. csv never attempts MongoDB.
LACLAUGPT_VIS_STORAGE_BACKEND=auto

# Safe defaults: files + memory + local filesystem. Redis is not required.
LACLAUGPT_VIS_DATA_BACKEND=files
LACLAUGPT_VIS_CACHE_BACKEND=memory
LACLAUGPT_VIS_OBJECT_BACKEND=local
LACLAUGPT_VIS_MESSAGING_BACKEND=none
LACLAUGPT_VIS_DATA_DIR=data
LACLAUGPT_VIS_OUTPUT_DIR=data/exports
LACLAUGPT_VIS_SQLITE_PATH=data/database/visualization.sqlite3
LACLAUGPT_VIS_SERVER_HOST=127.0.0.1
LACLAUGPT_VIS_SERVER_PORT=8501
LACLAUGPT_VIS_CACHE_MAX_ENTRIES=512

# Optional Phase 0 browser list. Off by default. When enabled it reads the shared
# Phase 0 MongoDB collection laclaugpt2_<project>_scraper_collection read-only.
# LACLAUGPT_VIS_PHASE0_BROWSER_ENABLED=true
# LACLAUGPT_VIS_PHASE0_BROWSER_LIMIT=100
# LACLAUGPT_PROJECT_ID=ai26
# LACLAUGPT_MONGODB_URI=mongodb://127.0.0.1:27017/
# LACLAUGPT_MONGODB_DATABASE=laclaugpt
#
# Visualization-specific aliases are also accepted for isolated deployments:
# LACLAUGPT_VIS_PHASE0_PROJECT_ID=ai26
# LACLAUGPT_VIS_PHASE0_MONGODB_URI=mongodb://127.0.0.1:27017/
# LACLAUGPT_VIS_PHASE0_MONGODB_DATABASE=laclaugpt

# Optional specialized Phase 1 dashboard restored by issue #96. Disabled by default.
# LACLAUGPT_VIS_SPECIALIZED_PLEDGE_DASHBOARD_ENABLED=true

# Same-machine module chain: point at the sibling Analysis module's private data tree.
# LACLAUGPT_VIS_ANALYSIS_DATA_DIR=../LaclauGPT-Data-Analysis/data

# Optional transient worker/status enrichment and human-facing Redis control plane.
# The URL and actor permissions are private runtime configuration. Do not commit real values.
# LACLAUGPT_VIS_MESSAGING_BACKEND=redis
# LACLAUGPT_VIS_CACHE_BACKEND=redis
# LACLAUGPT_REDIS_URL=redis://127.0.0.1:6379/0
# LACLAUGPT_VIS_REDIS_HEARTBEAT_TTL_SECONDS=60
# LACLAUGPT_VIS_REDIS_EVENT_LIMIT=25
# LACLAUGPT_VIS_ACTOR_ID=dashboard-user
# LACLAUGPT_VIS_ACTOR_KIND=human
# LACLAUGPT_VIS_CONTROL_PERMISSIONS=config.publish,message.send,task.trigger,task.retry,task.cancel

# Distributed profile: all real endpoints and credentials stay private.
# LACLAUGPT_VIS_STORAGE=distributed
# LACLAUGPT_VIS_STORAGE_BACKEND=auto
# LACLAUGPT_VIS_DATA_BACKEND=mongodb
# LACLAUGPT_VIS_MONGODB_URI=mongodb://127.0.0.1:27017/?tls=true
# LACLAUGPT_VIS_MONGODB_DATABASE=laclaugpt
# LACLAUGPT_VIS_CACHE_BACKEND=redis
# LACLAUGPT_REDIS_URL=redis://127.0.0.1:6379/0
# LACLAUGPT_VIS_OBJECT_BACKEND=s3
# LACLAUGPT_VIS_S3_ENDPOINT_URL=https://object.example.invalid
# LACLAUGPT_VIS_S3_BUCKET=research-placeholder
# LACLAUGPT_VIS_S3_ACCESS_KEY_ID=replace-me
# LACLAUGPT_VIS_S3_SECRET_ACCESS_KEY=replace-me
# LACLAUGPT_VIS_S3_REGION=region-placeholder
