# Copy to .env and edit locally. Never commit .env.

# Safe defaults: files + memory + local filesystem
LACLAUGPT_VIS_PROFILE=local
LACLAUGPT_VIS_DATA_BACKEND=files
LACLAUGPT_VIS_CACHE_BACKEND=memory
LACLAUGPT_VIS_OBJECT_BACKEND=local
LACLAUGPT_VIS_DATA_DIR=data
LACLAUGPT_VIS_OUTPUT_DIR=outputs
LACLAUGPT_VIS_SQLITE_PATH=data/laclaugpt.sqlite3

# Optional MongoDB
# LACLAUGPT_VIS_DATA_BACKEND=mongodb
# LACLAUGPT_VIS_MONGODB_URI=mongodb://localhost:27017
# LACLAUGPT_VIS_MONGODB_DATABASE=laclaugpt
# LACLAUGPT_VIS_MONGODB_COLLECTION=annotations

# Optional Redis
# LACLAUGPT_VIS_CACHE_BACKEND=redis
# LACLAUGPT_VIS_REDIS_URL=redis://localhost:6379/0

# Optional S3 / CSC Allas
# LACLAUGPT_VIS_OBJECT_BACKEND=s3
# LACLAUGPT_VIS_S3_ENDPOINT_URL=https://a3s.fi
# LACLAUGPT_VIS_S3_BUCKET=your-private-bucket
# LACLAUGPT_VIS_S3_ACCESS_KEY_ID=replace-me
# LACLAUGPT_VIS_S3_SECRET_ACCESS_KEY=replace-me
# LACLAUGPT_VIS_S3_REGION=regionOne
